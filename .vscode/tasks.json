{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "configure-cmake",
			"type": "shell",
			"command": "cmake -S ${workspaceFolder} -B ${workspaceFolder}/build -DCMAKE_BUILD_TYPE=Debug -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ && echo 'CMake configuration completed successfully.'",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": ["$gcc"],
			"detail": "Task to configure CMake with Clang."
		},
		{
			"label": "build-cmake",
			"type": "shell",
			"command": "cmake --build ${workspaceFolder}/build && echo 'CMake build completed successfully.'",
			"dependsOn": ["configure-cmake"],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": ["$gcc"],
			"detail": "Task generated by Debugger."
		}
	]
}
